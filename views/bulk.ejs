<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Bulk Update Requests</title>
    <link id="favicon" rel="icon" href="https://glitch.com/edit/favicon-app.ico" type="image/x-icon">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css" integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">
    <script src="https://code.jquery.com/jquery-3.4.1.min.js" integrity="sha256-CSXorXvZcTkaix6Yvo6HppcZGetbYMGWSFlBw8HfCJo=" crossorigin="anonymous"></script>
    <script src="https://extensions.tableauusercontent.com/resources/tableau.extensions.1.latest.min.js"></script>
    <script src="/bulk.js" defer></script>
  </head>
  <body>
    <div class="container" style="margin: 30px;">

      <h3>Bulk Update <small class="text-muted"><%= ids.length %> requests</small></h3>
      <p class="text-muted">Request IDs: <%= ids.join(", ") %></p>
      <p class="text-muted" style="font-size: 0.9em;">Check a field to apply it to every selected request. Unchecked fields are left untouched.</p>

      <input type="hidden" id="ids" value="<%= ids.join(',') %>">

      <%
        const techMixed = current.technician_id === null;
        const statusMixed = current.status === null;
        const commentsMixed = current.technician_comments === null;
      %>

      <div class="form-group">
        <div class="form-check mb-1">
          <input class="form-check-input apply-toggle" type="checkbox" id="applyTech" data-target="tech">
          <label class="form-check-label" for="applyTech"><b>Assigned to</b><% if (techMixed) { %> <span class="text-muted" style="font-weight: normal;">(mixed)</span><% } %></label>
        </div>
        <select class="form-control" id="tech" disabled>
          <% if (techMixed) { %><option value="" selected>-- Mixed --</option><% } %>
          <option value="" <%= !techMixed && current.technician_id == null ? 'selected' : '' %>>--Not assigned--</option>
          <%- techs.map(tech => {
            const sel = !techMixed && String(current.technician_id) === String(tech.technician_id) ? 'selected' : '';
            return `<option value="${tech.technician_id}" ${sel}>${tech.technician_name}</option>`;
          }).join("") %>
        </select>
      </div>

      <div class="form-group">
        <div class="form-check mb-1">
          <input class="form-check-input apply-toggle" type="checkbox" id="applyStatus" data-target="status">
          <label class="form-check-label" for="applyStatus"><b>Status</b><% if (statusMixed) { %> <span class="text-muted" style="font-weight: normal;">(mixed)</span><% } %></label>
        </div>
        <select class="form-control" id="status" disabled>
          <% if (statusMixed) { %><option value="" selected>-- Mixed --</option><% } %>
          <% ["Requested", "In Progress", "Closed"].forEach(status => { %>
            <%- `<option value="${status}" ${!statusMixed && current.status === status ? 'selected' : ''}>${status}</option>` %>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <div class="form-check mb-1">
          <input class="form-check-input apply-toggle" type="checkbox" id="applyComments" data-target="comments">
          <label class="form-check-label" for="applyComments"><b>Comments</b><% if (commentsMixed) { %> <span class="text-muted" style="font-weight: normal;">(mixed)</span><% } %></label>
        </div>
        <textarea class="form-control" id="comments" rows="3" placeholder="<%= commentsMixed ? '-- Mixed --' : '' %>" disabled><%= commentsMixed ? '' : (current.technician_comments || '') %></textarea>
      </div>

      <div class="row justify-content-end">
        <div class="col-auto">
          <button type="button" class="btn btn-secondary" onclick="cancelBulk()">Cancel</button>
        </div>
        <div class="col-auto">
          <button type="button" class="btn btn-primary" id="bulkSubmit" onclick="updateBulk()" disabled>Update All</button>
        </div>
      </div>

    </div>
  </body>
</html>
